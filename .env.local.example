# Copy to .env.local (gitignored) and fill in your own values.
#
# These name the cloud projects this checkout talks to. They are not secrets —
# they are the deployment's identity, which is exactly why they live outside
# version control (#2953): the scripts say *which environment* they mean, and
# this file says *whose*.
#
# Read by scripts/gcp_project.sh, which every npm script that reaches GCP goes
# through (secret fetches, local server startup, log export, Vertex config).
# Environment variables of the same name win over this file, which is how CI
# supplies them.

GCP_PROJECT_DEV=your-project-dev
GCP_PROJECT_PROD=your-project-prod

# Optional. The GitHub App that files user-feedback issues; unset leaves the
# feedback integration disabled locally, which is the documented behavior.
# GITHUB_APP_ID=0
# GITHUB_INSTALLATION_ID=0

# Optional. Target for `npm run test:server:e2e:dev`.
# E2E_SERVER_URL=https://server-dev.example.com
