# Terraform files to ignore
# See: https://github.com/github/gitignore/blob/main/Terraform.gitignore

# Local .terraform directories
**/.terraform/*

# .tfstate files
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Exclude all .tfvars files, which are likely to contain sensitive data
*.tfvars
*.tfvars.json

# Go build artifacts
server/server
/simulate
/generate_simulation_data

# Temporary local media store
media_storage/

# Node modules
node_modules/

# Local-only
tmp/
.secrets

# Local overrides for the GCP project names the npm scripts fetch secrets from
# (#2965). Project IDs are org identifiers, not secrets, but they are exactly
# what the open-source split (#2953) parameterizes out of package.json.
.env.local

# Service-account / credentials JSON files (#1769). Never commit. ADC is the
# production path; local dev should use `gcloud auth application-default
# login` or point GOOGLE_APPLICATION_CREDENTIALS at a path outside the repo.
secret_*.json
*-credentials.json
service-account*.json

# MacOS files
.DS_Store

# Android Studio config files
.idea/

# Android signing secrets
app/android/key.properties
*.jks
*.keystore

# Flutter build artifacts
app/build/
app/android/build/
app/ios/build/
app/.dart_tool/
app/.flutter-plugins
app/.flutter-plugins-dependencies
# Swift Package Manager state — the iOS project uses CocoaPods; these are
# generated by Flutter's SPM mode and should not be committed.
app/ios/**/xcshareddata/swiftpm/Package.resolved

# Generated code from protobuf definitions
server/gen/
app/lib/data/gen/
e2e/gen/

# Generated code from freezed and mockito
**/*.freezed.dart
**/*.mocks.dart
**/*.g.dart

# Personal editor state stays out, but the three shared files below are
# checked in on purpose. They are already tracked here, so the ignore never
# applied to them — but a FRESH clone of the open-source export starts with an
# empty index, and `git add -A` would silently skip them, shipping three files
# that could never be committed (#2953). The negations make the intent hold in
# both repos rather than depending on history.
#
# `.vscode/*` and not `.vscode/`: git cannot re-include a file whose parent
# DIRECTORY is excluded, so the negations below are dead against the latter.
.vscode/*
!.vscode/launch.json
!.vscode/settings.json
!.vscode/tasks.json

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
venv/
ENV/
.pytest_cache/
*.egg-info/
dist/
build/

# Model tuning artifacts (large binary files)
model_tuning/fine_tuned_ripls_model/
model_tuning/checkpoints/
# Note: *.onnx files are tracked with Git LFS (see .gitattributes)

# Runner secrets
runner/.env

# Claude Cowork collaborations
docs/cowork/

# Claude Code memory files (user-specific, not project-level)
.claude/projects/*/memory/

# Claude Code local session state
.claude/scheduled_tasks.lock
.claude/settings.local.json

# Local fetch cookie for scripts/fetch_pr_media.sh — never commit
.gh-user-session

# Flutter Web release bundle copied into the Go embed surface by
# `npm run build:web`. Only `placeholder.html` is tracked so
# //go:embed has at least one file on a fresh checkout.
server/services/web/app_assets/*
!server/services/web/app_assets/placeholder.html

# Parity-audit artifacts from issue #2188. Generated by
# `npm run parity:2188` — contain vendor place IDs and live query
# results. The methodology lives in docs/issues/2188-parity-audit.md,
# the starter query list lives in docs/issues/2188-parity-queries.json;
# both are tracked. The generated outputs are not.
docs/issues/2188-parity-audit-results.json
docs/issues/2188-parity-audit-summary.md

# Go compiled test binaries (go test -c output, e.g. server/request.test)
*.test

# Firebase Auth Emulator debug artifacts (written to cwd by firebase-tools)
firebase-debug.log
firebase-debug.*.log
ui-debug.log

# Sentinel design-token artifacts (#2770). `gen_design_tokens.js --sentinel`
# rewrites the generated Dart tokens to distinct hues and emits this map so the
# composited-contrast analyzer can attribute pixels to tokens. Both are
# throwaway build inputs for one gate run — the Dart file is restored by
# `npm run generate:design-tokens` (the gate's EXIT trap does this), and the map
# is regenerated on every run.
design/sentinel_map.json

# Contrast-evaluation renders (#2770). Working artifacts, not deliverables:
# every one is regenerable with `e2e/scripts/run_contrast_shipped.sh` and they
# run to hundreds of megabytes of PNG — 1,100 files and ~600 MB at the point
# this was added, for pages that answer one question and are then stale.
#
# The reviewer-facing comparison is NOT here: it lives under
# website/content/contrast-review/ so the staging deploy publishes it.
docs/concepts/theme/contrast-*.html
docs/concepts/theme/contrast-*/
