    "version": "0.2.0",
    "configurations": [
        {
            "name": "app: Development (dev)",
            "cwd": "app",
            "request": "launch",
            "type": "dart",
            "program": "lib/main.dart",
            "args": [
                "--dart-define-from-file=env.dev.json"
            ]
        },
        {
            "name": "app: Local Server",
            "cwd": "app",
            "request": "launch",
            "type": "dart",
            "program": "lib/main.dart",
            "args": [
                "--dart-define-from-file=env.local.json"
            ]
        },
        {
            "name": "app: Production (prod)",
            "cwd": "app",
            "request": "launch",
            "type": "dart",
            "program": "lib/main.dart",
            "args": [
                "--dart-define-from-file=env.prod.json"
            ]
        },
        {
            "name": "app: Profile Mode (dev)",
            "cwd": "app",
            "request": "launch",
            "type": "dart",
            "program": "lib/main.dart",
            "flutterMode": "profile",
            "args": [
                "--dart-define-from-file=env.dev.json"
            ]
        },
        {
            "name": "app: Release Mode (prod)",
            "cwd": "app",
            "request": "launch",
            "type": "dart",
            "program": "lib/main.dart",
            "flutterMode": "release",
            "args": [
                "--dart-define-from-file=env.prod.json"
            ]
        }
    ]
}