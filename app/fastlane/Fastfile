# Fastfile for Ripls Flutter App
# This file defines automation lanes for building and deploying the app

default_platform(:ios)

require 'yaml'

#──────────────────────────────────────────────────────────────────────────────
# Helper Methods
#──────────────────────────────────────────────────────────────────────────────

# Get semantic version from pubspec.yaml
def get_base_version
  pubspec_path = File.join(Dir.pwd, "..", "pubspec.yaml")
  pubspec = YAML.load_file(pubspec_path)
  version_string = pubspec["version"].to_s
  # Handle both "1.2.0" and "1.2.0+123" formats
  version_string.split("+").first
end

# Get build number: git commit count plus BUILD_NUMBER_OFFSET (versions.env).
# release_app.yaml calls the same script, so the label and the upload agree.
def get_build_number
  sh(File.expand_path("../../scripts/build_number.sh", __dir__), log: false).strip.to_i
end

# Compare a build number with the highest one a store already has, before
# building. Equal means this commit was already uploaded (a re-run of the same
# tag), so the lane skips. Lower means the number went backwards — after a move
# to a new git history, BUILD_NUMBER_OFFSET is too small (#3228). The store
# would reject that upload, and skipping it would hide the problem on every
# release from then on, so it fails instead. Returns true when the lane should
# skip.
def already_uploaded?(build, store_latest, store:)
  if store_latest > build
    UI.user_error!("Build #{build} is lower than the latest on #{store} (#{store_latest}). " \
                   "Raise BUILD_NUMBER_OFFSET in versions.env so that " \
                   "scripts/build_number.sh prints more than #{store_latest}.")
  end
  store_latest == build
end

# Get full version info
def get_version_info
  version = get_base_version
  build = get_build_number
  {
    version: version,
    build: build,
    full: "#{version}+#{build}"
  }
end

# Get release notes for the current version (plain text format for app stores)
# Looks for website/content/release-notes/{version}.txt (generated by npm run generate)
# The .txt file includes the URL to full HTML release notes
def get_release_notes(version)
  txt_path = File.join(Dir.pwd, "..", "..", "website", "content", "release-notes", "#{version}.txt")

  unless File.exist?(txt_path)
    UI.user_error!("Release notes not found at #{txt_path}. " \
                   "Please create docs/release/notes/#{version}.md and run 'npm run generate'.")
  end

  UI.message("Using plain text release notes: #{txt_path}")
  File.read(txt_path).strip
end

# Map a dart-define env file name to the GCP project whose Secret Manager
# holds the matching Google Maps keys (#1768/#1770).
def secrets_project_for(env_file)
  case env_file
  when "env.prod.json" then "ripls-prod"
  else "ripls-dev"
  end
end

# Resolve GOOGLE_MAPS_API_KEY and return a --dart-define flag for it.
# The native Maps SDKs need this key: Android reads it from the manifest
# meta-data (build.gradle.kts fills the placeholder from the
# GOOGLE_MAPS_API_KEY *environment variable*), and iOS forwards the
# --dart-define value to GMSServices.provideAPIKey over a method channel.
# CI injects the key via the GOOGLE_MAPS_API_KEY env var (set from
# google-maps-api-key-{android,ios} by get-secretmanager-secrets in
# release_app.yaml); local dev falls back to fetching from Secret Manager.
# We also re-export ENV["GOOGLE_MAPS_API_KEY"] so the Gradle subprocess
# `flutter build` spawns inherits it for the Android manifest placeholder.
# Release lanes pass maps_required: true (default) so a missing key crashes
# the build via UI.user_error! — we never ship an app with a non-functional
# map (#2188). Smoke / local-debug lanes pass maps_required: false.
def google_maps_dart_define(env_file, platform:, maps_required: true)
  secret = platform == :ios ? "google-maps-api-key-ios" : "google-maps-api-key-android"

  key = ENV["GOOGLE_MAPS_API_KEY"].to_s.strip
  if key.empty?
    project = secrets_project_for(env_file)
    # Fastlane cwd is app/fastlane/ — script lives at repo root.
    key = `../../scripts/fetch_secret.sh #{project} #{secret}`.strip
  end

  if key.empty?
    msg = "Could not resolve GOOGLE_MAPS_API_KEY from env or Secret Manager (#{secret})."
    if maps_required
      UI.user_error!("#{msg} In CI, ensure google-github-actions/auth@v3 " \
                     "and get-secretmanager-secrets@v2 fetched #{secret} and " \
                     "exported GOOGLE_MAPS_API_KEY. Locally, run " \
                     "`gcloud auth application-default login` and retry. " \
                     "Refusing to build a release artifact with a " \
                     "non-functional map.")
    end
    UI.important("#{msg} Building without it (maps will not render). " \
                 "This is expected on smoke / local-debug lanes.")
    return ""
  end

  # Android's manifest placeholder reads the env var (not the dart-define),
  # so re-export it for the Gradle subprocess `flutter build` spawns.
  ENV["GOOGLE_MAPS_API_KEY"] = key
  "--dart-define=GOOGLE_MAPS_API_KEY=#{key}"
end

# Resolve the client-side Places/Geocoding key and return a --dart-define
# flag for it (#2246). Unlike google_maps_dart_define, this is a SINGLE,
# platform-independent key (google-maps-api-key-client-places) that is
# API-restricted to Places + Geocoding but NOT application-restricted —
# so the Flutter REST client (Environment.googlePlacesApiKey) needs no
# per-platform X-Android-Cert / X-Ios-Bundle-Identifier headers. It is
# distinct from the per-platform map-SDK keys above. CI injects it via the
# GOOGLE_MAPS_PLACES_KEY env var (set from google-maps-api-key-client-places
# by get-secretmanager-secrets in release_app.yaml); local dev falls back to
# Secret Manager. Release lanes require it so we never ship non-functional
# location search.
def google_maps_places_dart_define(env_file, places_required: true)
  key = ENV["GOOGLE_MAPS_PLACES_KEY"].to_s.strip
  if key.empty?
    project = secrets_project_for(env_file)
    # Fastlane cwd is app/fastlane/ — script lives at repo root.
    key = `../../scripts/fetch_secret.sh #{project} google-maps-api-key-client-places`.strip
  end

  if key.empty?
    msg = "Could not resolve GOOGLE_MAPS_PLACES_KEY from env or Secret " \
          "Manager (google-maps-api-key-client-places)."
    if places_required
      UI.user_error!("#{msg} In CI, ensure get-secretmanager-secrets@v2 " \
                     "fetched google-maps-api-key-client-places and exported " \
                     "GOOGLE_MAPS_PLACES_KEY. Locally, run " \
                     "`gcloud auth application-default login` and retry. " \
                     "Refusing to build a release artifact with broken " \
                     "location search.")
    end
    UI.important("#{msg} Building without it (location search will not work). " \
                 "This is expected on smoke / local-debug lanes.")
    return ""
  end

  "--dart-define=GOOGLE_MAPS_PLACES_KEY=#{key}"
end

# Run Flutter build with version info
def flutter_build(platform:, release_type: "release", env_file: "env.prod.json", maps_required: true)
  v = get_version_info
  UI.message("Building #{platform} version #{v[:full]} with #{env_file}")

  env_flag = "--dart-define-from-file=#{env_file}"
  maps_flag = google_maps_dart_define(env_file, platform: platform, maps_required: maps_required)
  places_flag = google_maps_places_dart_define(env_file, places_required: maps_required)

  case platform
  when :ios
    sh("cd .. && flutter build ios --#{release_type} --no-codesign " \
       "#{env_flag} #{maps_flag} #{places_flag} --build-name=#{v[:version]} --build-number=#{v[:build]}")
  when :android_apk
    sh("cd .. && flutter build apk --#{release_type} " \
       "#{env_flag} #{maps_flag} #{places_flag} --build-name=#{v[:version]} --build-number=#{v[:build]}")
  when :android_appbundle
    sh("cd .. && flutter build appbundle --#{release_type} " \
       "#{env_flag} #{maps_flag} #{places_flag} --build-name=#{v[:version]} --build-number=#{v[:build]}")
  end

  v
end

#──────────────────────────────────────────────────────────────────────────────
# iOS Lanes
#──────────────────────────────────────────────────────────────────────────────

platform :ios do

  desc "Sync code signing certificates using Match"
  lane :sync_certificates do
    match(
      type: "appstore",
      readonly: is_ci,  # CI should never create new certs
      git_url: ENV["MATCH_GIT_URL"],
      app_identifier: ENV["APP_IDENTIFIER_IOS"] || CredentialsManager::AppfileConfig.try_fetch_value(:app_identifier)
    )
  end

  desc "Build iOS app without signing (CI smoke test)"
  lane :build_only do
    # Smoke build: runner may not have GCP creds, so don't require the
    # Google Maps keys.
    flutter_build(platform: :ios, maps_required: false)
    UI.success("✅ iOS release build succeeded (unsigned)")
  end

  desc "Build iOS app and upload to TestFlight"
  lane :release do |options|
    # Critical: setup_ci creates a temporary keychain, without it builds can freeze
    setup_ci if ENV['CI']

    # In CI, skip clean/pub get since workflow already handles code generation
    unless options[:skip_prep] || ENV["CI"]
      sh("cd .. && flutter clean")
      sh("cd .. && flutter pub get")
    end

    api_key = app_store_connect_api_key(
      key_id: ENV["APP_STORE_CONNECT_KEY_ID"],
      issuer_id: ENV["APP_STORE_CONNECT_ISSUER_ID"],
      key_content: ENV["APP_STORE_CONNECT_KEY_CONTENT"],
      is_key_content_base64: true
    )

    # Check the build number against TestFlight before spending a build on it.
    # No `version:` filter: build numbers increase across versions, so the
    # app's latest build of any version is the one to beat.
    planned = get_version_info
    app_identifier = ENV["APP_IDENTIFIER_IOS"] || CredentialsManager::AppfileConfig.try_fetch_value(:app_identifier)
    latest_build = latest_testflight_build_number(
      api_key: api_key,
      app_identifier: app_identifier
    )
    if already_uploaded?(planned[:build], latest_build, store: "TestFlight")
      UI.important("Build #{planned[:build]} already exists on TestFlight, skipping")
      UI.success("✅ iOS #{planned[:full]} already uploaded")
      next  # Exit the lane early
    end

    # Build Flutter iOS (unsigned)
    version_info = flutter_build(platform: :ios)

    # Sync certificates
    sync_certificates

    # Configure code signing
    project_path = File.expand_path("../ios/Runner.xcodeproj", __dir__)
    update_code_signing_settings(
      use_automatic_signing: false,
      path: project_path,
      team_id: ENV["APPLE_TEAM_ID"] || "2HL54765FF",
      profile_name: "match AppStore org.ripls.app",
      code_sign_identity: "Apple Distribution"
    )

    # Build signed IPA
    workspace_path = File.expand_path("../ios/Runner.xcworkspace", __dir__)
    output_dir = File.expand_path("./build/ios", __dir__)
    build_app(
      workspace: workspace_path,
      scheme: "Runner",
      configuration: "Release",  # Explicitly use Release config (org.ripls.app bundle ID)
      export_method: "app-store",
      output_directory: output_dir,
      output_name: "Ripls.ipa",
      export_options: {
        provisioningProfiles: {
          "org.ripls.app" => "match AppStore org.ripls.app"
        }
      }
    )

    # Upload dSYMs to Firebase Crashlytics
    dsym_path = lane_context[SharedValues::DSYM_OUTPUT_PATH]
    if dsym_path && File.exist?(dsym_path)
      UI.message("Uploading dSYMs to Crashlytics: #{dsym_path}")
      upload_symbols_to_crashlytics(
        dsym_path: dsym_path,
        gsp_path: File.expand_path("../ios/Runner/GoogleService-Info.plist", __dir__),
        binary_path: File.expand_path("../ios/Pods/FirebaseCrashlytics/upload-symbols", __dir__)
      )
      UI.success("dSYMs uploaded to Crashlytics")
    else
      UI.important("No dSYMs found to upload")
    end

    # Get release notes for "What to Test" field
    release_notes = get_release_notes(version_info[:version])

    begin
      upload_to_testflight(
        api_key: api_key,
        skip_waiting_for_build_processing: false,  # Wait for processing to enable distribution
        distribute_external: true,
        groups: ["Ripls External Alpha"],  # Group to notify; public link sharing is enabled in App Store Connect
        changelog: release_notes
      )
      UI.success("✅ iOS #{version_info[:full]} uploaded to TestFlight for external testing!")
    rescue StandardError => e
      if e.message.include?("Another build is in review")
        UI.important("Another build is in review, skipping TestFlight upload")
        UI.success("✅ iOS #{version_info[:full]} build complete (upload skipped - build in review)")
      else
        raise e
      end
    end
  end

  desc "Promote latest TestFlight build to App Store review"
  lane :promote_to_app_store do
    api_key = app_store_connect_api_key(
      key_id: ENV["APP_STORE_CONNECT_KEY_ID"],
      issuer_id: ENV["APP_STORE_CONNECT_ISSUER_ID"],
      key_content: ENV["APP_STORE_CONNECT_KEY_CONTENT"],
      is_key_content_base64: true
    )

    deliver(
      api_key: api_key,
      skip_binary_upload: true,
      skip_screenshots: true,
      skip_metadata: true,
      submit_for_review: true,
      automatic_release: false,  # Manually release after approval
      submission_information: {
        add_id_info_uses_idfa: false
      }
    )

    UI.success("✅ iOS build submitted for App Store review!")
  end

end

#──────────────────────────────────────────────────────────────────────────────
# Android Lanes
#──────────────────────────────────────────────────────────────────────────────

platform :android do

  desc "Build Android app and upload to Play Store open testing (beta) track"
  lane :release do |options|
    # In CI, skip clean/pub get since workflow already handles code generation
    unless options[:skip_prep] || ENV["CI"]
      sh("cd .. && flutter clean")
      sh("cd .. && flutter pub get")
    end

    # Check the version code against Play before spending a build on it. A
    # promoted build leaves beta for production, so the highest code can be on
    # either track.
    planned = get_version_info
    package_name = ENV["APP_IDENTIFIER_ANDROID"] || "org.ripls.app"
    existing_codes = %w[beta production].flat_map do |track|
      google_play_track_version_codes(
        package_name: package_name,
        track: track,
        json_key_data: ENV["PLAY_STORE_SERVICE_ACCOUNT_JSON"]
      )
    end
    if already_uploaded?(planned[:build], existing_codes.max || 0, store: "Play")
      UI.important("Build #{planned[:build]} already exists on Play, skipping")
      UI.success("✅ Android #{planned[:full]} already uploaded")
      next  # Exit the lane early
    end

    # Build Flutter Android App Bundle
    version_info = flutter_build(platform: :android_appbundle)

    # Get release notes and write to Play Store changelog format
    # Google Play limits "What's new" to 500 characters
    release_notes = get_release_notes(version_info[:version])
    max_length = 500
    if release_notes.length > max_length
      truncated_notes = release_notes[0, max_length - 3] + "..."
      UI.important("Release notes truncated from #{release_notes.length} to #{max_length} characters for Play Store")
      release_notes = truncated_notes
    end

    metadata_dir = File.expand_path("metadata/android", __dir__)
    changelog_dir = File.join(metadata_dir, "en-US", "changelogs")
    FileUtils.mkdir_p(changelog_dir)
    changelog_path = File.join(changelog_dir, "#{version_info[:build]}.txt")
    File.write(changelog_path, release_notes)
    UI.message("Wrote changelog (#{release_notes.length} chars) to #{changelog_path}")

    # Upload to Play Store beta track (open testing)
    aab_path = File.expand_path("../build/app/outputs/bundle/release/app-release.aab", __dir__)
    upload_to_play_store(
      package_name: package_name,
      track: "beta",
      aab: aab_path,
      json_key_data: ENV["PLAY_STORE_SERVICE_ACCOUNT_JSON"],
      metadata_path: metadata_dir,
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true,
      skip_upload_changelogs: false,
      release_status: "completed"
    )

    UI.success("✅ Android #{version_info[:full]} uploaded to open testing (beta) track!")
  end

  desc "Promote from beta track to production"
  lane :promote_to_production do |options|
    rollout = (options[:rollout] || "1.0").to_f  # Default 100% rollout

    upload_to_play_store(
      package_name: ENV["APP_IDENTIFIER_ANDROID"] || "org.ripls.app",
      track: "beta",
      track_promote_to: "production",
      rollout: rollout.to_s,
      skip_upload_aab: true,
      skip_upload_metadata: true,
      json_key_data: ENV["PLAY_STORE_SERVICE_ACCOUNT_JSON"]
    )

    UI.success("✅ Android promoted to production (#{(rollout * 100).to_i}% rollout)!")
  end

  desc "Build APK for local testing"
  lane :build_local do
    # Debug build: developer may not have gcloud auth, so don't require the
    # Google Maps keys.
    version_info = flutter_build(platform: :android_apk, release_type: "debug",
                                 env_file: "env.dev.json", maps_required: false)
    UI.success("✅ Debug APK built: #{version_info[:full]}")
  end

end
