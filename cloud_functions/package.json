{
  "name": "ripls-cloud-functions",
  "version": "0.1.0",
  "private": true,
  "description": "Cloud Functions for ripls observability automation. See the #1148/#1149 plan (archived) for the design.",
  "engines": {
    "node": "24"
  },
  "main": "lib/index.js",
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "lint": "eslint --ext .ts src",
    "test": "vitest run",
    "test:watch": "vitest",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log"
  },
  "dependencies": {
    "firebase-admin": "^13.0.1",
    "firebase-functions": "^7.2.5"
  },
  "devDependencies": {
    "@types/node": "^22.19.19",
    "@typescript-eslint/eslint-plugin": "^8.14.0",
    "@typescript-eslint/parser": "^8.14.0",
    "eslint": "^10.0.0",
    "typescript": "^6.0.0",
    "vitest": "^4.1.8"
  }
}
