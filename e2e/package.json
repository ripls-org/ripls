{
  "name": "@ripls/e2e",
  "version": "0.0.0",
  "private": true,
  "description": "Playwright Test harness driving the Flutter Web bundle. See ./README.md.",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "install:browsers": "playwright install --with-deps chromium webkit",
    "report": "playwright show-report",
    "test:lib": "tsx --test lib/*.test.ts",
    "env:start": "tsx scripts/investigate_env.ts start",
    "env:stop": "tsx scripts/investigate_env.ts stop",
    "env:status": "tsx scripts/investigate_env.ts status"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@bufbuild/protobuf": "2.15.0",
    "@connectrpc/connect": "2.2.0",
    "@connectrpc/connect-web": "2.2.0",
    "@connectrpc/connect-node": "2.2.0",
    "firebase-tools": "15.30.2",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "@types/node": "22.20.4"
  },
  "engines": {
    "node": ">=22"
  }
}
