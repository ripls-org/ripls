{
  "compilerOptions": {
    "target": "ES2022",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "lib": ["ES2022", "DOM"],
    // @types/node is a devDependency but was never wired in, so every
    // `process`, `__dirname` and `node:*` reference failed to typecheck (126 of
    // the 144 errors the first `tsc --noEmit` run produced). Nothing ran tsc,
    // so nobody saw them.
    "types": ["node"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "rootDir": ".",
    "paths": {
      "@gen/*": ["./gen/*"]
    }
  },
  "include": ["lib/**/*.ts", "tests/**/*.ts", "gen/**/*.ts", "scripts/**/*.ts", "playwright.config.ts"],
  "exclude": ["node_modules", "test-results", "playwright-report", "investigations"]
}
