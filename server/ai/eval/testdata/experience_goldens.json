        "title_contains_mode": "all",
        "date": "2026-04-22",
        "time": "10:00",
        "time_confidence_any_of": ["EXPLICIT"],
        "location_query_contains": ["Chautauqua"],
        "search_keywords_must_contain": ["hik"],
