# Canonical toolchain versions for CI images, release builds, and local dev.
#
# This is the single source of truth. Consumers read it directly rather than
# mirroring it:
#   - runner image: build-args from runners/docker-compose.yml + sync.sh, and
#     the GHCR build workflow (runners/Dockerfile declares bare ARGs, no pins).
#   - prod image: build_and_deploy_container.yaml passes --build-arg from here
#     (the Dockerfile keeps guarded ARG defaults for plain `docker build`).
#   - Flutter workflows: a step sources this file into $GITHUB_ENV so subosito
#     installs the pinned FLUTTER_VERSION.
# scripts/check_versions.js guards the few remaining source mirrors (go.mod, the
# prod Dockerfile ARG defaults) and fails CI if a migrated file re-pins a literal.
#
# Shell-sourceable (KEY=VALUE, no spaces): `set -a; . versions.env; set +a`.
#
# These are the versions CI installs. A deployment running its own runner fleet
# also bakes them into a runner image built from these values, so a bump to a
# baked tool (Go/Node/Flutter/JDK/NDK/ONNX) has to roll that image before those
# jobs pick it up; see the runner tooling in the private deploy repo. The
# dev-local doctor (npm run doctor:versions) flags a toolchain that differs
# from this.

# The `# renovate:` annotations below let Renovate's custom manager open a PR
# against this file when a new upstream version drops (see renovate.json). Each
# such PR is labeled "needs runner rebuild" and never auto-merges — a baked-tool
# bump must be validated and the runner image republished (see #2287).

# renovate: datasource=golang-version depName=go
GO_VERSION=1.27.1
# renovate: datasource=node-version depName=node versioning=node
NODE_MAJOR=24
# renovate: datasource=flutter-version depName=flutter
FLUTTER_VERSION=3.47.5
# JAVA_VERSION feeds runners/Dockerfile as `temurin-${JAVA_VERSION}-jdk`, and
# Temurin's apt packages are named by major only (temurin-25-jdk). The
# java-version datasource returns full build strings (25.0.3+9), so the
# extractVersion below keeps just the major — without it Renovate proposes the
# nonexistent temurin-25.0.3+9-jdk and every java patch PR sticks red on the
# Validate Runner Candidate gate (#2416). Major bumps still surface, and route to
# human review via the global major rule.
#
# 25 is the current LTS and the ceiling worth taking (#2787): 26 is non-LTS and
# neither AGP nor Kotlin claims support for it. Do not go below 21 — AGP 9.3+
# bundles a lint that calls the Java 21 List.removeLast() from Java 8 bytecode,
# so every Android release build dies on JDK 17.
# renovate: datasource=java-version depName=java extractVersion=^(?<version>\d+)
JAVA_VERSION=25
# NDK has no clean Renovate datasource (distributed via the Android SDK manager),
# so it is tracked manually rather than by a custom manager.
NDK_VERSION=28.2.13676358
# renovate: datasource=github-releases depName=microsoft/onnxruntime extractVersion=^v(?<version>.*)$
ONNXRUNTIME_VERSION=1.29.0

# Go lint toolchain, baked into the runner image. These were `@latest` until
# #1611 made `npm run lint:go` a required CI check — at which point an unpinned
# linter means a runner rebuild can turn a green branch red with no repo change,
# and the failure looks like a code regression rather than a tool bump.
#
# golangci-lint v1 and v2 are different module paths
# (github.com/golangci/golangci-lint/cmd/... vs .../v2/cmd/...) and v2
# restructured the config schema. The v2 migration landed in #3008; a further
# major would again be a deliberate migration of server/.golangci.yml, not a
# version bump — the two majors refuse each other's config outright.
#
# Unlike the other baked tools, this one is ALSO honoured pre-merge: the
# `go-lint` input of .github/actions/setup-toolchain installs this exact version
# when it differs from what the runner image has baked. Without that, a bump here
# would be linted by the old binary and only take effect after the fleet rolls —
# which for a config-schema change means every PR on main goes red in between.
# renovate: datasource=github-releases depName=golangci/golangci-lint extractVersion=^v(?<version>.*)$
GOLANGCI_LINT_VERSION=2.13.2
# Pinned to the version the runner image actually has, so local and CI agree.
# Getting this wrong is not theoretical: this was briefly set to 0.9.1 (a dev
# machine's version) while the runners ran 0.11.0, and CI immediately failed on a
# file 0.9.1 considers correctly formatted and 0.11.0 does not. A gofumpt bump can
# reformat files, so it has to arrive as a Renovate PR that reformats in the same
# commit — which is exactly what pinning buys, provided the pin matches reality.
# renovate: datasource=github-releases depName=mvdan/gofumpt extractVersion=^v(?<version>.*)$
GOFUMPT_VERSION=0.12.0

# iOS / macOS build toolchain, recorded from the Mac that builds iOS releases.
# These are doctor-checked host values (npm run doctor:versions on a Mac), NOT
# Docker build-args — Xcode etc. are not apt-installable. IOS_DEPLOYMENT_TARGET
# is additionally a source mirror that check_versions.js enforces against the
# Podfile + Xcode project. See docs/release/ios_build_server_setup.md and #2287.
XCODE_VERSION=26.5
COCOAPODS_VERSION=1.16.2
RUBY_VERSION=4.0.3
IOS_DEPLOYMENT_TARGET=15.0
